# Version control
.git
.gitignore
.gitattributes

# Local agent / IDE state
.codegraph/
.codex/
.cursor/
.playwright-mcp/
.trellis/

# Maven / Java
**/target/
.mvn/
*.class

# Node.js / frontend
/frontend/
**/node_modules/
**/dist/
**/.pnpm-store/
pnpm-lock.yaml
package-lock.json
yarn.lock

# IDEs
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# Environment and secrets
.env
.env.*
!.env.example

# Logs and temporary files
*.log
logs/
tmp/
temp/
test-output.txt

# Evaluation and local generated artifacts are not needed for backend images
/eval/
/backend/src/test/
/backend/cp.txt
/compile-log.txt
/rageval-run*.log

# OS files
.DS_Store
Thumbs.db

# Test and coverage output
**/coverage/
**/.nyc_output/
**/test-results/

# Documentation is not needed in the backend image. Do not exclude backend
# resource markdown files such as runtime reference resources.
/docs/
/study/
/*.md
!/README.md

# Docker compose files are not needed inside the image
docker-compose*.yml
.dockerignore
