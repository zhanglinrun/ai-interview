# ================================
# 必需配置 - 请替换为您的实际密钥
# ================================

# 阿里云百炼 AI (DashScope) - LLM 与 Embedding 服务
AI_BAILIAN_API_KEY=your_dashscope_api_key_here

# MinerU 官方精准解析 API。Token 只写本机/服务器 .env，不提交。
MINERU_ENABLED=true
MINERU_BASE_URL=https://mineru.net
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL_MS=2000
MINERU_TASK_TIMEOUT_SECONDS=300
MINERU_PRESIGNED_URL_TTL_SECONDS=600

# 【安全必填】JWT 签名密钥：至少 32 字节强随机串。
# 后端启动会校验，若为空或等于内置默认值将拒绝启动（防止公开密钥被伪造任意用户令牌）。
# 生成示例：openssl rand -base64 48
APP_JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-bytes

# 【安全必填(生产)】Provider API Key 加密密钥（AES-256）。
# 建议 32 字节 Base64 或长随机串；生产部署（docker-compose-app.yml）要求非空，
# 否则 Provider API Key 会用源码内公开 fallback key 加密，等同明文存储。
APP_AI_CONFIG_ENCRYPTION_KEY=
# 生产置 true 强制要求上面的加密密钥（compose 已默认开启）
APP_AI_CONFIG_REQUIRE_ENCRYPTION_KEY=false

# ================================
# 文字服务配置
# ================================

# LM Studio 本地 Provider（可选）
# PROVIDER_LMSTUDIO_API_KEY=lm-studio

# Moonshot AI / Kimi (https://platform.moonshot.cn/)
PROVIDER_KIMI_API_KEY=
PROVIDER_KIMI_MODEL=kimi-k2.6

# DeepSeek (https://platform.deepseek.com/)
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_DEEPSEEK_MODEL=deepseek-v4-flash

# 智谱 AI / GLM (https://open.bigmodel.cn/)
PROVIDER_GLM_API_KEY=
PROVIDER_GLM_MODEL=glm-5

# GitHub 公共仓库代码证据（Token 可空；配置后仅提高公共只读 API 限额，不需要私库权限）
GITHUB_ENABLED=true
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_PUBLIC_TOKEN=
GITHUB_SYNC_MAX_FILES=120
GITHUB_SYNC_MAX_BYTES=10485760
# GitHub 官方远程 MCP（可选）。Token 只需公共仓库只读权限；未配置时自动回退固定 SHA 快照。
GITHUB_MCP_ENABLED=false
GITHUB_MCP_ENDPOINT=https://api.githubcopilot.com/mcp/
GITHUB_MCP_ACCESS_TOKEN=
GITHUB_MCP_MAX_RESPONSE_BYTES=1048576

# Judge0 外部客观判题（未配置时明确显示“待补判”，不会由 LLM 伪判）
JUDGE0_ENABLED=false
JUDGE0_BASE_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_CONNECT_TIMEOUT_MS=5000
JUDGE0_REQUEST_TIMEOUT_MS=10000
JUDGE0_JAVA_LANGUAGE_ID=
JUDGE0_PYTHON3_LANGUAGE_ID=
JUDGE0_POLL_INTERVAL_MS=1000
JUDGE0_TIMEOUT_SECONDS=30
JUDGE0_CPU_TIME_LIMIT_SECONDS=3
JUDGE0_MEMORY_LIMIT_KB=262144

# 自定义 OpenAI 兼容 Provider 示例:
# 添加后需在 application.yml 的 app.ai.providers 中配置对应的 base-url 和 model
# PROVIDER_MYPROVIDER_API_KEY=your_api_key_here

# ================================
# 可选配置 - 与 dev-ops/docker-compose-environment.yml 对齐（本地 bootRun 连 compose 依赖时勿改）
# ================================

# MySQL（dev-ops environment compose 宿主机 33306，避开 agent-group 13306）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=33306
MYSQL_DB=ai_interview
MYSQL_USER=ai_interview
MYSQL_PASSWORD=ai_interview
MYSQL_ROOT_PASSWORD=root

# Redis（宿主机 26379，与 dev-ops compose / 避开 agent-group 16379）
REDIS_HOST=localhost
REDIS_PORT=26379
REDIS_PASSWORD=

# Elasticsearch 向量存储（宿主机 29200，1536 维 text-embedding-v4）
ES_HOST=http://localhost:29200
ES_INDEX_NAME=ai-interview-vector
ES_DIMENSIONS=1536

# MinIO 对象存储（宿主机 29000 API / 29001 控制台，避开 agent-group 9000）
MINIO_URL=http://localhost:29000
MINIO_ENDPOINT=http://localhost:29000
# 使用真实 MinerU 联调时必须改成云端可访问的 HTTPS MinIO 签名入口。
MINIO_EXTERNAL_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-interview

# ================================
# RabbitMQ（唯一异步任务引擎，dev compose 会随依赖拉起）
# ================================
# 宿主机 bootRun 连 dev compose 的 RabbitMQ（5672）；管理台 http://localhost:15672（guest/guest）。
# 若 5672/15672 已被其他项目占用（如 ai-group 的 RabbitMQ），把下面四个端口一起改，
# 例如 RABBITMQ_PORT=25672、RABBITMQ_HOST_PORT=25672、RABBITMQ_MGMT_HOST_PORT=25673
#（RABBITMQ_PORT 是应用连接端口，HOST_PORT 两个是 compose 的宿主机映射，需保持一致）。
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# dev compose 宿主机端口（默认 amqp 5672 / 管理台 15672）
# RABBITMQ_HOST_PORT=5672
# RABBITMQ_MGMT_HOST_PORT=15672

# RAG 分场景模型（留空则复用设置页默认 Chat 模型，当前 dashscope 为 qwen3.5-flash）
# 勿填 qwen-max-latest，除非账号已开通该模型（否则会路由失败并降级 hybrid）
APP_AI_RAG_INTENT_MODEL=
APP_AI_RAG_REWRITE_MODEL=
APP_AI_RAG_ROUTING_MODEL=
APP_AI_RAG_GENERATION_MODEL=qwen3.6-plus
APP_AI_RAG_TITLE_MODEL=qwen3.5-flash
APP_AI_RAG_HYBRID_MODE=hybrid
APP_AI_RAG_HYBRID_DUAL_CHANNEL=true
APP_AI_RAG_PARENT_EXPAND_STRATEGY=replace

# AI 模型配置（默认聊天/改写兜底: qwen3.5-flash）
AI_MODEL=qwen3.5-flash

# 雪花 ID workerId（可选，多实例部署时建议每实例显式指定 0-1023；
# 不配置时自动取本机 IP 低 10 位，再兜底 PID）
# WORKER_ID=1
