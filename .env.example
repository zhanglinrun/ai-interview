# ================================
# 必需配置 - 请替换为您的实际密钥
# ================================

# 阿里云百炼 AI (DashScope) - LLM 与 Embedding 服务
AI_BAILIAN_API_KEY=your_dashscope_api_key_here

# MinerU 官方精准解析 API。Token 只写本机/服务器 .env，不提交。
MINERU_ENABLED=true
MINERU_BASE_URL=https://mineru.net
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL_MS=2000
MINERU_TASK_TIMEOUT_SECONDS=900
MINERU_UPLOAD_TIMEOUT_MS=180000
MINERU_MAX_PAGES_PER_REQUEST=200
MINERU_PRESIGNED_URL_TTL_SECONDS=600

# Sa-Token 会话（生产建议使用 Redis，并设置独立的 token 名称与超时时间）
SA_TOKEN_NAME=satoken
SA_TOKEN_TIMEOUT=2592000
SA_TOKEN_ACTIVE_TIMEOUT=86400
SA_TOKEN_LOG=false
SA_TOKEN_READ_COOKIE=false

# 【安全必填(生产)】Provider API Key 加密密钥（AES-256）。
# 建议 32 字节 Base64 或长随机串；生产部署（docker-compose-app.yml）要求非空，
# 否则 Provider API Key 会用源码内公开 fallback key 加密，等同明文存储。
APP_AI_CONFIG_ENCRYPTION_KEY=
# 生产置 true 强制要求上面的加密密钥（compose 已默认开启）
APP_AI_CONFIG_REQUIRE_ENCRYPTION_KEY=false

# ================================
# 文字服务配置
# ================================

# LM Studio 本地 Provider（可选）
# PROVIDER_LMSTUDIO_API_KEY=lm-studio

# Moonshot AI / Kimi (https://platform.moonshot.cn/)
PROVIDER_KIMI_API_KEY=
PROVIDER_KIMI_MODEL=kimi-k2.6

# DeepSeek (https://platform.deepseek.com/)
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_DEEPSEEK_MODEL=deepseek-v4-flash

# 智谱 AI / GLM (https://open.bigmodel.cn/)
PROVIDER_GLM_API_KEY=
PROVIDER_GLM_MODEL=glm-5

# GitHub 公共仓库代码证据（Token 可空；配置后仅提高公共只读 API 限额，不需要私库权限）
GITHUB_ENABLED=true
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_PUBLIC_TOKEN=
GITHUB_SYNC_MAX_FILES=120
GITHUB_SYNC_MAX_BYTES=10485760
# GitHub 官方远程 MCP（可选）。Token 只需公共仓库只读权限；未配置时自动回退固定 SHA 快照。
GITHUB_MCP_ENABLED=false
GITHUB_MCP_ENDPOINT=https://api.githubcopilot.com/mcp/
GITHUB_MCP_ACCESS_TOKEN=
GITHUB_MCP_MAX_RESPONSE_BYTES=1048576

# 自定义 OpenAI 兼容 Provider 示例:
# 添加后需在 application.yml 的 app.ai.providers 中配置对应的 base-url 和 model
# PROVIDER_MYPROVIDER_API_KEY=your_api_key_here

# ================================
# 可选配置 - 与 dev-ops/docker-compose-environment.yml 对齐（本地 bootRun 连 compose 依赖时勿改）
# ================================

# MySQL（dev-ops environment compose 宿主机 33306，避开 agent-group 13306）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=33306
MYSQL_DB=ai_interview_v2
# docker-compose-app.yml 的全栈 V2 数据库；显式保留该变量便于覆盖默认值
APP_MYSQL_DB=ai_interview_v2
MYSQL_USER=ai_interview
MYSQL_PASSWORD=ai_interview
MYSQL_ROOT_PASSWORD=root

# Redis（宿主机 26379，与 dev-ops compose / 避开 agent-group 16379）
REDIS_HOST=localhost
REDIS_PORT=26379
REDIS_PASSWORD=

# Elasticsearch 向量存储（宿主机 29200，1536 维 text-embedding-v4）
ES_HOST=http://localhost:29200
ES_INDEX_NAME=ai-interview-vector
ES_DIMENSIONS=1536

# MinIO 对象存储（宿主机 29000 API / 29001 控制台，避开 agent-group 9000）
MINIO_URL=http://localhost:29000
MINIO_ENDPOINT=http://localhost:29000
# 使用真实 MinerU 联调时必须改成云端可访问的 HTTPS MinIO 签名入口。
# 本地 Docker MinIO 对云端不可达：先开隧道再填这里，不要填 localhost。
#   powershell -File dev-ops/minio-mineru-tunnel.ps1
# 应用上传仍走 MINIO_ENDPOINT；只有预签名 URL 用这个公网地址。
MINIO_EXTERNAL_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-interview

# ================================
# RabbitMQ（唯一异步任务引擎，dev compose 会随依赖拉起）
# ================================
# 宿主机 bootRun 连 dev compose 的 RabbitMQ（5672）；管理台 http://localhost:15672（guest/guest）。
# 若 5672/15672 已被其他项目占用（如 ai-group 的 RabbitMQ），把下面四个端口一起改，
# 例如 RABBITMQ_PORT=25672、RABBITMQ_HOST_PORT=25672、RABBITMQ_MGMT_HOST_PORT=25673
#（RABBITMQ_PORT 是应用连接端口，HOST_PORT 两个是 compose 的宿主机映射，需保持一致）。
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# dev compose 宿主机端口（默认 amqp 5672 / 管理台 15672）
# RABBITMQ_HOST_PORT=5672
# RABBITMQ_MGMT_HOST_PORT=15672

# Neo4j 领域图检索（随本地 Compose 默认启动；保存 Agent/框架/RAG 等实体关系）
NEO4J_URI=bolt://localhost:27687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-neo4j-password
NEO4J_DATABASE=neo4j
APP_AI_RAG_NEO4J_ENABLED=true
# 应用启动后自动幂等导入 resources/neo4j/ai-interview-domain.json
APP_AI_RAG_NEO4J_SEED_ENABLED=true
# 平台公开实体使用 ownerUserId=0；查询范围为平台实体 + 当前用户实体
APP_AI_RAG_NEO4J_PLATFORM_OWNER_ID=0
# 当前领域图不包含文档分段，因此不强制 docId IN $knowledgeBaseIds
APP_AI_RAG_NEO4J_KB_SCOPE_REQUIRED=false
# 默认开启用户范围过滤，Cypher 必须使用 ownerUserId IN $graphOwnerIds 参数
APP_AI_RAG_NEO4J_USER_SCOPE_REQUIRED=true
APP_AI_RAG_NEO4J_USER_SCOPE_PROPERTY=ownerUserId

# RAG 决策阶段（意图/改写/HyDE/路由/分解）走平台快模型，不走用户 BYOK
# 分项留空则用 DECISION_MODEL。生成仍用 GENERATION_MODEL 或用户「我的模型」
APP_AI_RAG_DECISION_MODEL=qwen3.5-flash
APP_AI_RAG_INTENT_MODEL=
APP_AI_RAG_REWRITE_MODEL=
APP_AI_RAG_ROUTE_MODEL=
APP_AI_RAG_GENERATION_MODEL=qwen3.6-plus
# 非流式 ChatModel 读超时（秒）；流式生成不受影响。面试出题带证据时 12s 容易被掐断。
APP_AI_CHAT_READ_TIMEOUT_SECONDS=45
APP_AI_RAG_HYDE_TIMEOUT_MS=4000
APP_AI_RAG_TITLE_MODEL=qwen3.5-flash
APP_AI_RAG_HYBRID_MODE=hybrid
APP_AI_RAG_HYBRID_DUAL_CHANNEL=true
APP_AI_RAG_PARENT_EXPAND_STRATEGY=keep
APP_AI_RAG_PARENT_EXPAND_MAX_CHARS=4000
APP_AI_RAG_CONTEXT_MAX_TOTAL_CHARS=18000
# 评测 gold 基线显示 CRAG 会把已召回的八股片段误判 INCORRECT 并清空证据；默认关闭。
APP_AI_RAG_CRAG_ENABLED=false

# 可选 XXL-Job 补偿调度（本地默认关闭；生产打开后注册 RAG 三个补偿 Handler）
APP_JOB_XXL_ENABLED=false
XXL_JOB_ADMIN_ADDRESSES=http://localhost:8080/xxl-job-admin
XXL_JOB_APP_NAME=ai-interview-backend
XXL_JOB_EXECUTOR_ADDRESS=
XXL_JOB_EXECUTOR_IP=
XXL_JOB_EXECUTOR_PORT=9999
XXL_JOB_ACCESS_TOKEN=

# AI 模型配置（默认聊天/改写兜底；简历向评测可用 qwen3.7-plus）
AI_MODEL=qwen3.7-plus

# 新 RAG 评测（eval/rag；正式数只来自这里）
RAGEVAL_BASE_URL=http://localhost:8080
RAGEVAL_SATOKEN=
RAGEVAL_KB_IDS=
RAGEVAL_CORPUS_VERSION=eval-corpus-mianzha-2026-08-16

# RAGAS Judge（eval/rag/runner/eval.py；Key 可用与 AI_BAILIAN 相同的 DashScope Key）
RAGAS_LLM_MODEL=qwen3.7-plus
RAGAS_EMBED_MODEL=text-embedding-v4
RAGAS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=

# 雪花 ID workerId（可选，多实例部署时建议每实例显式指定 0-1023；
# 不配置时自动取本机 IP 低 10 位，再兜底 PID）
# WORKER_ID=1

# ================================
# 全栈上线（docker-compose-app.yml）
# 默认按 4C6G 演示机限内存；Neo4j / XXL-Job 保持开启。
# 本地 IDEA 只起 environment 时下面可以不改。
# ================================
# 上线必改：管理口只绑回环，公网只开前端（Nginx 反代 /api/）。
# COMPOSE_PUBLISH_HOST=127.0.0.1
# FRONTEND_PUBLISH_HOST=0.0.0.0
# FRONTEND_HOST_PORT=80
#
# 上线必改口令（不要用仓库默认值）：
# APP_AI_CONFIG_ENCRYPTION_KEY=
# APP_AI_CONFIG_REQUIRE_ENCRYPTION_KEY=true
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=
# NEO4J_PASSWORD=
# RABBITMQ_USER=
# RABBITMQ_PASSWORD=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# XXL_JOB_ACCESS_TOKEN=
# XXL_JOB_MYSQL_PASSWORD=
# XXL_JOB_MYSQL_ROOT_PASSWORD=
# APP_JOB_XXL_ENABLED=true
#
# 当前入库主路径是 PDF 直传 MinerU OSS，MinIO 不必对公网开放。
# 只有旧的 URL 回源才需要公网 HTTPS 入口：
# MINIO_EXTERNAL_ENDPOINT=https://files.example.com
#
# 内存盖（compose 已内置 4C6G 默认值；8C16G 再抬这些）
# ES_MEM_LIMIT=1280m
# ES_JAVA_OPTS=-Xms512m -Xmx512m
# APP_MEM_LIMIT=1536m
# APP_JAVA_OPTS=-Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai -Xms256m -Xmx768m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
# NEO4J_MEM_LIMIT=768m
# NEO4J_HEAP_INITIAL=256m
# NEO4J_HEAP_MAX=384m
# NEO4J_PAGECACHE=192m
# MYSQL_MEM_LIMIT=512m
# MYSQL_INNODB_BUFFER_POOL=128M
# XXL_JOB_ADMIN_MEM_LIMIT=512m
# XXL_JOB_JAVA_OPTS=-Xms128m -Xmx384m
# XXL_JOB_MYSQL_MEM_LIMIT=384m
# RABBITMQ_MEM_LIMIT=256m
# MINIO_MEM_LIMIT=256m
# REDIS_MEM_LIMIT=128m
# FRONTEND_MEM_LIMIT=64m
