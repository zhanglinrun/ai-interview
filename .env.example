# ================================
# 必需配置 - 请替换为您的实际密钥
# ================================

# 阿里云百炼 AI (DashScope) - LLM + ASR + TTS 服务
AI_BAILIAN_API_KEY=your_dashscope_api_key_here

# ================================
# 文字服务配置
# ================================

# LM Studio 本地 Provider（可选）
# PROVIDER_LMSTUDIO_API_KEY=lm-studio

# Moonshot AI / Kimi (https://platform.moonshot.cn/)
PROVIDER_KIMI_API_KEY=
PROVIDER_KIMI_MODEL=kimi-k2.6

# DeepSeek (https://platform.deepseek.com/)
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_DEEPSEEK_MODEL=deepseek-v4-flash

# 智谱 AI / GLM (https://open.bigmodel.cn/)
PROVIDER_GLM_API_KEY=
PROVIDER_GLM_MODEL=glm-5

# 自定义 OpenAI 兼容 Provider 示例:
# 添加后需在 application.yml 的 app.ai.providers 中配置对应的 base-url 和 model
# PROVIDER_MYPROVIDER_API_KEY=your_api_key_here

# ================================
# 可选配置 - 与根目录 docker-compose.yml 对齐（本地 bootRun 连 compose 起的依赖时勿改）
# ================================

# MySQL（docker-compose.dev.yml 默认：库 interview_guide / 用户 interview_guide / 密码 interview_guide / 端口 3306）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=interview_guide
MYSQL_USER=interview_guide
MYSQL_PASSWORD=interview_guide
MYSQL_ROOT_PASSWORD=root

# Redis（compose 映射 6379）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch 向量存储（1536 维 text-embedding-v4）
ES_HOST=http://localhost:9200
ES_INDEX_NAME=interview-guide-vector
ES_DIMENSIONS=1536

# MinIO 对象存储（dev compose 映射 9000 API / 9001 控制台）
MINIO_URL=http://localhost:9000
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=interview-guide

# Neo4j 图数据库（Text2Cypher）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j666

# XXL-Job 2.4（补偿任务）
XXL_JOB_ADMIN=http://127.0.0.1:8080/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=default_token
XXL_JOB_EXECUTOR=ai-interview-executor

# RAG 分场景模型（对齐 know-engine）
APP_AI_RAG_INTENT_MODEL=qwen-max-latest
APP_AI_RAG_REWRITE_MODEL=qwen-max-latest
APP_AI_RAG_ROUTING_MODEL=qwen-max-latest
APP_AI_RAG_GENERATION_MODEL=qwen3.6-plus
APP_AI_RAG_TITLE_MODEL=qwen3.5-flash
APP_AI_RAG_HYBRID_MODE=hybrid
APP_AI_RAG_HYBRID_DUAL_CHANNEL=true
APP_AI_RAG_PARENT_EXPAND_STRATEGY=replace
APP_AI_RAG_GRAPH_AUTO_SYNC=true
APP_AI_RAG_GRAPH_SKILL_BOOTSTRAP=true

# AI 模型配置（默认聊天/改写兜底: qwen3.5-flash）
AI_MODEL=qwen3.5-flash

# 语音面试（可选）：多段 STT 合并后再触发面试官；ASR 句间静音阈值（越大越不易句中切开）
# APP_VOICE_USER_UTTERANCE_DEBOUNCE_MS=1600
# APP_VOICE_ASR_SILENCE_MS=1000

# ================================
# 钉钉机器人（可选，对齐 know-engine）
# know-engine 写在 application.yml 的 dingtalk.appKey/appSecret/robotCode；
# 本项目统一放 .env，由 backend/src/main/resources/application.yml → app.dingtalk.* 注入
# ================================
#
# | know-engine (application.yml) | ai-interview (.env)              |
# |-------------------------------|----------------------------------|
# | dingtalk.appKey               | APP_DINGTALK_APP_KEY             |
# | dingtalk.appSecret            | APP_DINGTALK_APP_SECRET          |
# | dingtalk.robotCode            | APP_DINGTALK_ROBOT_CODE           |
# | （无）                        | APP_DINGTALK_SYSTEM_USER_ID       |
# | （无）                        | APP_DINGTALK_DEFAULT_KB_IDS        |
#
# Stream 模式（与 know-engine ChatBotCallbackListener 一致）：
# APP_DINGTALK_ENABLED=true
# APP_DINGTALK_STREAM_ENABLED=true
# APP_DINGTALK_APP_KEY=your_app_key
# APP_DINGTALK_APP_SECRET=your_app_secret
# APP_DINGTALK_ROBOT_CODE=your_robot_code
# APP_DINGTALK_SYSTEM_USER_ID=1
# APP_DINGTALK_DEFAULT_KB_IDS=1,2
#
# Webhook 模式（自定义机器人加签，备选）：
# APP_DINGTALK_ENABLED=true
# APP_DINGTALK_WEBHOOK_TOKEN=SECxxxx
# APP_DINGTALK_SYSTEM_USER_ID=1
# APP_DINGTALK_DEFAULT_KB_IDS=1,2
#
APP_DINGTALK_ENABLED=false
APP_DINGTALK_STREAM_ENABLED=false
APP_DINGTALK_APP_KEY=
APP_DINGTALK_APP_SECRET=
APP_DINGTALK_ROBOT_CODE=
APP_DINGTALK_WEBHOOK_TOKEN=
APP_DINGTALK_SYSTEM_USER_ID=
APP_DINGTALK_DEFAULT_KB_IDS=
