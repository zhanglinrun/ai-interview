# 生产环境变量模板（单机 4C6G、5 人以内）
# 用法：在服务器 dev-ops 目录 cp .env.prod.example .env，填好下面所有【必填】项，
# 然后 docker compose --env-file .env -f docker-compose-prod.yml up -d --build
#
# 生成强随机值（Linux）：
#   openssl rand -base64 48      # 用于 APP_JWT_SECRET / APP_AI_CONFIG_ENCRYPTION_KEY / 各密码

# ===== 【必填】安全密钥 =====
# JWT 签名密钥（≥32 字节强随机；为空或用内置默认后端拒绝启动）
APP_JWT_SECRET=
# BYOK 用户 Key 的 AES-GCM 加密密钥（≥32 字节强随机）。
# ⚠️ 一旦有用户存了 Key，此值不可再改，否则旧密文无法解密。
APP_AI_CONFIG_ENCRYPTION_KEY=

# ===== 【必填】平台全局 Embedding Key =====
# 唯一的平台侧 AI 成本（很便宜）。chat 由访客 BYOK 自带，不花这个 key。
# DashScope（阿里云百炼）示例；也可换其它 OpenAI 兼容 embedding provider。
AI_BAILIAN_API_KEY=
AI_MODEL=qwen3.5-flash

# ===== 【必填】MinerU 官方精准解析 =====
MINERU_ENABLED=true
MINERU_BASE_URL=https://mineru.net
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL_MS=2000
MINERU_TASK_TIMEOUT_SECONDS=300
MINERU_PRESIGNED_URL_TTL_SECONDS=600

# ===== GitHub 公共仓库代码证据 =====
# Token 可空；填写平台公共只读 Token 可提高 API 限额，不需要私库权限。
GITHUB_ENABLED=true
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_PUBLIC_TOKEN=
GITHUB_SYNC_MAX_FILES=120
GITHUB_SYNC_MAX_BYTES=10485760
# GitHub 官方远程 MCP（可选）；无 Token 时保持 false，系统使用固定 SHA 快照。
GITHUB_MCP_ENABLED=false
GITHUB_MCP_ENDPOINT=https://api.githubcopilot.com/mcp/
GITHUB_MCP_ACCESS_TOKEN=
GITHUB_MCP_MAX_RESPONSE_BYTES=1048576

# ===== Judge0 外部客观判题（未配置前保持 false） =====
JUDGE0_ENABLED=false
JUDGE0_BASE_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_CONNECT_TIMEOUT_MS=5000
JUDGE0_REQUEST_TIMEOUT_MS=10000
JUDGE0_JAVA_LANGUAGE_ID=
JUDGE0_PYTHON3_LANGUAGE_ID=
JUDGE0_POLL_INTERVAL_MS=1000
JUDGE0_TIMEOUT_SECONDS=30
JUDGE0_CPU_TIME_LIMIT_SECONDS=3
JUDGE0_MEMORY_LIMIT_KB=262144

# ===== 【必填】数据库 / 存储 / MQ 密码（务必改掉默认值，公网服务器） =====
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# 必须与下面 FILES_DOMAIN 对应，例如 https://files.interview.example.com。
# 仅供 MinerU 获取短时签名对象，不开放桶列表或写方法。
MINIO_EXTERNAL_ENDPOINT=
RABBITMQ_PASSWORD=

# ===== HTTPS / 私有文件域名 =====
# 只填主机名，不带 https://；两个域名都需解析到服务器并满足部署地合规要求。
APP_DOMAIN=interview.example.com
FILES_DOMAIN=files.interview.example.com
ACME_EMAIL=
# 必须是浏览器实际访问的 origin，不带路径；多个 origin 用逗号分隔。
CORS_ALLOWED_ORIGINS=https://interview.example.com

# ===== 可观测性（宿主机仅绑定 127.0.0.1，使用 SSH 隧道访问） =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
KIBANA_ENCRYPTION_KEY=
PROMETHEUS_RETENTION=7d
PROMETHEUS_RETENTION_SIZE=512MB
LOG_RETENTION_DAYS=7
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
KIBANA_HOST_PORT=5601

# ===== 可选（有默认值，可不改） =====
# 第一阶段 IP 直连的对外端口（docker-compose-ip.yml 用）：http://<IP>:8080
WEB_HOST_PORT=8080
MYSQL_DB=ai_interview
MYSQL_USER=ai_interview
MINIO_BUCKET=ai-interview
ES_DIMENSIONS=1536
RABBITMQ_USER=ai_interview
# 当前 Compose 使用云端 Rerank，并默认关闭可选 CRAG；GitHub REST 固定 SHA 证据默认开启。
