# 生产环境变量模板（大陆 4C4G 部署）
# 用法：在服务器 dev-ops 目录 cp .env.prod.example .env，填好下面所有【必填】项，
# 然后 docker compose --env-file .env -f docker-compose-prod.yml up -d --build
#
# 生成强随机值（Linux）：
#   openssl rand -base64 48      # 用于 APP_JWT_SECRET / APP_AI_CONFIG_ENCRYPTION_KEY / 各密码

# ===== 【必填】安全密钥 =====
# JWT 签名密钥（≥32 字节强随机；为空或用内置默认后端拒绝启动）
APP_JWT_SECRET=
# BYOK 用户 Key 的 AES-GCM 加密密钥（≥32 字节强随机）。
# ⚠️ 一旦有用户存了 Key，此值不可再改，否则旧密文无法解密。
APP_AI_CONFIG_ENCRYPTION_KEY=

# ===== 【必填】平台全局 Embedding Key =====
# 唯一的平台侧 AI 成本（很便宜）。chat 由访客 BYOK 自带，不花这个 key。
# DashScope（阿里云百炼）示例；也可换其它 OpenAI 兼容 embedding provider。
AI_BAILIAN_API_KEY=
AI_MODEL=qwen3.5-flash

# ===== 【必填】数据库 / 存储 / MQ 密码（务必改掉默认值，公网服务器） =====
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
RABBITMQ_PASSWORD=

# ===== 可选（有默认值，可不改） =====
# 第一阶段 IP 直连的对外端口（docker-compose-ip.yml 用）：http://<IP>:8080
WEB_HOST_PORT=8080
MYSQL_DB=ai_interview
MYSQL_USER=ai_interview
MINIO_BUCKET=ai-interview
ES_DIMENSIONS=1536
RABBITMQ_USER=guest
# 4C4G 的功能边界已固定在 Compose：云端 Rerank；Graph/MCP/Text2SQL/CRAG/GitHub 工具关闭。
# 升配到 8G 后若要演示可选能力，应同时修改 Compose 并补齐对应依赖，不能只改环境变量。
