{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Caddy does not response-buffer SSE; frontend nginx also disables proxy
	# buffering for /api, so REST uploads and text/event-stream share one route.
	reverse_proxy frontend:80
}

{$FILES_DOMAIN} {
	# Only presigned object reads are exposed. Bucket writes and the MinIO console
	# remain Docker-network-only; unsigned reads are rejected by the private bucket.
	@deniedMethods {
		not method GET HEAD OPTIONS
	}
	respond @deniedMethods 405
	reverse_proxy minio:9000
}
